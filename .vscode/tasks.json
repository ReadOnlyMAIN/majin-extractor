{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Extract ALL .pak files",
            "type": "shell",
            "command": "python pak_extractor1_fixed.py \"ExtractedISO/PS3_GAME/USRDIR/finalizedPS3/KB/package/\" --out DECOMPRESSED_ALL_v2",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Convert ALL XET textures to PNG",
            "type": "shell",
            "command": "python previous_work/xet_to_png_fixed.py DECOMPRESSED_ALL_v2 --out TEXTURES_ALL --recursive",
            "group": "build",
            "dependsOn": [
                "Extract ALL .pak files"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Convert DDS textures to PNG",
            "type": "shell",
            "command": "python previous_work/dds_to_png_fixed.py DECOMPRESSED_ALL_v2 --out TEXTURES_ALL",
            "group": "build",
            "dependsOn": [
                "Extract ALL .pak files"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Convert ALL DDM models to OBJ",
            "type": "shell",
            "command": "python previous_work/ddm_decoder.py DECOMPRESSED_ALL_v2 --out MODELS_ALL --batch",
            "group": "build",
            "dependsOn": [
                "Extract ALL .pak files"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Test single .pak (gim001.pak)",
            "type": "shell",
            "command": "python pak_extractor1_fixed.py \"ExtractedISO/PS3_GAME/USRDIR/finalizedPS3/KB/package/gim001.pak\" --out DECOMPRESSED_TEST",
            "group": "test",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Convert DECOMPRESSED_TEST to PNG",
            "type": "shell",
            "command": "python previous_work/xet_to_png_fixed.py DECOMPRESSED_TEST --out TEXTURES_TEST --recursive",
            "group": "test",
            "dependsOn": [
                "Test single .pak (gim001.pak)"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Clean temp directories",
            "type": "shell",
            "command": "rm -rf DECOMPRESSED_TEST TEXTURES_TEST",
            "group": "none",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Count files by type",
            "type": "shell",
            "command": "python -c \"import os; from collections import Counter; mc = Counter(); [mc.update([open(os.path.join(r,f),'rb').read(4)]) for r,d,fs in os.walk('DECOMPRESSED_ALL_v2') for f in fs]; [print(f'{m.hex()}: {c} files') for m,c in mc.most_common()]\"",
            "group": "test",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}