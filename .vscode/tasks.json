{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PAK: extract",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "tools/extraction/pak_extractor.py",
                "game_files/package",
                "--out",
                "game_files/decompressed",
                "--quiet"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUNBUFFERED": "1"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "XET: recursive conversion",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "tools/conversion/xet_to_png.py",
                "game_files/decompressed",
                "--out",
                "output/textures",
                "--recursive"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUNBUFFERED": "1"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "DDS: recursive conversion",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "tools/conversion/dds_to_png.py",
                "game_files/decompressed",
                "--out",
                "output/textures",
                "--recursive"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUNBUFFERED": "1"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Pipeline: extraction and textures",
            "dependsOrder": "sequence",
            "dependsOn": [
                "PAK: extract",
                "XET: recursive conversion",
                "DDS: recursive conversion"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
