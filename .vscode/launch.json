{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PAK: extract a file or directory",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/extraction/pak_extractor.py",
            "args": [
                "${input:pakSource}",
                "--out",
                "${input:decompressedDir}",
                "--workers",
                "${input:workerCount}"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "XET: convert a file or directory",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/conversion/xet_to_png.py",
            "args": [
                "${input:resourceSource}",
                "--out",
                "${input:textureOutput}",
                "--recursive"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "DDS: convert a file or directory",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/conversion/dds_to_png.py",
            "args": [
                "${input:resourceSource}",
                "--out",
                "${input:textureOutput}",
                "--recursive"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "Godot: export selected folder",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/conversion/export_folder_to_godot.py",
            "args": [
                "${input:godotExportSource}",
                "--animations",
                "${input:ddmAnimations}",
                "--ik",
                "${input:ddmIK}",
                "--godot-project",
                "${input:godotProject}"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "DDM: export model with animations",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/conversion/ddm_to_3d.py",
            "args": [
                "${input:ddmCharacterSource}",
                "${input:modelOutput}",
                "--material-mode",
                "${input:ddmMaterialMode}",
                "--animations",
                "${input:ddmAnimations}",
                "--ik",
                "${input:ddmIK}",
                "--scale",
                "${input:ddmExportScale}"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "Godot: validate animated GLB",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/validation/check_godot_animation.py",
            "args": [
                "${input:animatedGlb}",
                "--godot",
                "${input:godotExecutable}"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "DDM: debug manual layout (no textures)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/conversion/ddm_to_3d.py",
            "args": [
                "${input:ddmManualSource}",
                "${input:modelOutput}",
                "--vertex-count",
                "${input:ddmVertexCount}",
                "--position-offset",
                "${input:ddmPositionOffset}",
                "--index-offset",
                "${input:ddmIndexOffset}",
                "--index-count",
                "${input:ddmIndexCount}",
                "--scale",
                "${input:ddmExportScale}",
                "--no-textures",
                "--debug"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        }
    ],
    "inputs": [
        {
            "id": "pakSource",
            "type": "promptString",
            "description": "PAK file or directory containing PAK files",
            "default": "game_files/package"
        },
        {
            "id": "decompressedDir",
            "type": "promptString",
            "description": "Directory for decompressed resources",
            "default": "game_files/decompressed"
        },
        {
            "id": "workerCount",
            "type": "promptString",
            "description": "Number of decompression threads",
            "default": "4"
        },
        {
            "id": "resourceSource",
            "type": "promptString",
            "description": "Resource file or directory to convert",
            "default": "game_files/decompressed"
        },
        {
            "id": "textureOutput",
            "type": "promptString",
            "description": "PNG texture output directory",
            "default": "output/textures"
        },
        {
            "id": "godotExportSource",
            "type": "promptString",
            "description": "Extracted KB folder to export for Godot",
            "default": "game_files/decompressed/KB/map/map101"
        },
        {
            "id": "ddmCharacterSource",
            "type": "promptString",
            "description": "DDM model to export with decoded animation segments",
            "default": "game_files/decompressed/KB/chara/chr300/chr300"
        },
        {
            "id": "ddmManualSource",
            "type": "promptString",
            "description": "Single DDM file for manual layout debugging",
            "default": "game_files/decompressed/KB/chara/chr300/chr300_c01"
        },
        {
            "id": "modelOutput",
            "type": "promptString",
            "description": "Model output directory",
            "default": "output/decoded/chara"
        },
        {
            "id": "ddmMaterialMode",
            "type": "pickString",
            "description": "GLB material output",
            "options": [
                "pbr",
                "godot",
                "original-godot"
            ],
            "default": "pbr"
        },
        {
            "id": "ddmExportScale",
            "type": "promptString",
            "description": "DDM position scale applied to GLB export",
            "default": "0.01"
        },
        {
            "id": "ddmVertexCount",
            "type": "promptString",
            "description": "Manual vertex count",
            "default": "367"
        },
        {
            "id": "ddmPositionOffset",
            "type": "promptString",
            "description": "Manual position stream offset",
            "default": "0x2191"
        },
        {
            "id": "ddmIndexOffset",
            "type": "promptString",
            "description": "Manual index stream offset",
            "default": "0x33d"
        },
        {
            "id": "ddmIndexCount",
            "type": "promptString",
            "description": "Manual uint16 index count",
            "default": "948"
        },
        {
            "id": "ddmAnimations",
            "type": "promptString",
            "description": "all, none, or comma-separated animation names/globs/physical segment indices",
            "default": "all"
        },
        {
            "id": "ddmIK",
            "type": "pickString",
            "description": "Bake declared IK chains into portable GLB animations, or export FK only",
            "options": [
                "bake",
                "off"
            ],
            "default": "bake"
        },
        {
            "id": "animatedGlb",
            "type": "promptString",
            "description": "Exported GLB with adjacent .motion.json report",
            "default": "/mnt/ssd990pro/Projects/Godot/majin-godot/original_files/decoded/animation_validation_20261027/chr301/chr301.glb"
        },
        {
            "id": "godotExecutable",
            "type": "promptString",
            "description": "Godot 4 executable path or command available in PATH",
            "default": "/mnt/ssd990pro/Software/godot/Godot_v4.8-dev7_linux.x86_64"
        },
        {
            "id": "godotProject",
            "type": "promptString",
            "description": "Destination Godot project (exports to original_files/decoded)",
            "default": "/mnt/ssd990pro/Projects/Godot/majin-godot"
        }
    ]
}
