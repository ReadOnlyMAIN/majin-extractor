{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PAK: extract a file or directory",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/extraction/pak_extractor.py",
            "args": [
                "${input:pakSource}",
                "--out",
                "${input:decompressedDir}",
                "--workers",
                "${input:workerCount}"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "XET: convert a file or directory",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/conversion/xet_to_png.py",
            "args": [
                "${input:resourceSource}",
                "--out",
                "${input:textureOutput}",
                "--recursive"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "DDS: convert a file or directory",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/conversion/dds_to_png.py",
            "args": [
                "${input:resourceSource}",
                "--out",
                "${input:textureOutput}",
                "--recursive"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "DDM: convert to GLB",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/conversion/ddm_to_obj.py",
            "args": [
                "${input:ddmSource}",
                "${input:modelOutput}",
                "--format",
                "glb",
                "--recursive",
                "--final",
                "${input:ddmFinalOutput}",
                "--scale",
                "${input:ddmExportScale}",
                "--roughness",
                "${input:ddmRoughness}"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        }
    ],
    "inputs": [
        {
            "id": "pakSource",
            "type": "promptString",
            "description": "PAK file or directory containing PAK files",
            "default": "game_files/package"
        },
        {
            "id": "decompressedDir",
            "type": "promptString",
            "description": "Directory for decompressed resources",
            "default": "game_files/decompressed"
        },
        {
            "id": "workerCount",
            "type": "promptString",
            "description": "Number of decompression threads",
            "default": "4"
        },
        {
            "id": "resourceSource",
            "type": "promptString",
            "description": "Resource file or directory to convert",
            "default": "game_files/decompressed"
        },
        {
            "id": "textureOutput",
            "type": "promptString",
            "description": "PNG texture output directory",
            "default": "output/textures"
        },
        {
            "id": "ddmSource",
            "type": "promptString",
            "description": "DDM file or directory to convert recursively",
            "default": "game_files/decompressed/KB/chara"
        },
        {
            "id": "modelOutput",
            "type": "promptString",
            "description": "Model output directory",
            "default": "output/models"
        },
        {
            "id": "ddmFinalOutput",
            "type": "pickString",
            "description": "Generate final GLB only (embedded textures)",
            "options": [
                "true",
                "false"
            ],
            "default": "true"
        },
        {
            "id": "ddmExportScale",
            "type": "promptString",
            "description": "DDM position scale applied to GLB export",
            "default": "0.01"
        },
        {
            "id": "ddmRoughness",
            "type": "promptString",
            "description": "GLB material roughness (negative uses Phong-derived values)",
            "default": "0.8"
        }
    ]
}
